<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- The gallery reads the device's own recordings and music. API 33 split
         the single storage permission into per-media-type grants; API 31-32
         still use READ_EXTERNAL_STORAGE, which the maxSdkVersion keeps from
         being requested on newer releases. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- localeConfig feeds the system per-app language picker from API 33 up;
         AppCompat's auto-store service below covers the older releases, so the
         attribute is deliberately declared on a minSdk 31 app. -->
    <application
        android:name=".CueApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cue"
        tools:ignore="UnusedAttribute,UnusedTranslation">

        <!-- Hebrew lives in res/values-iw: the resource matcher resolves a Hebrew
             request through the legacy "iw" code, so res/values-he never matches
             and every string would fall back to English. The modern "he" tag is
             still what locales_config.xml and the app-locale APIs use. -->


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Cue">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- The aliases point here, not at MainActivity: an alias that targets
             the real screen becomes the task's base, so disabling it when the
             palette changes would destroy the running task. -->
        <activity
            android:name=".LauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Cue.Launcher" />

        <!-- One launcher entry per palette. MainActivity itself has no
             MAIN/LAUNCHER filter: the aliases carry it so the home-screen icon
             can change colour with the app theme. LauncherIcon switches them. -->
        <activity-alias
            android:name=".MainActivityMint"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mint"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mint"
            android:targetActivity=".LauncherActivity"
            android:theme="@style/Theme.Cue.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLagoon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lagoon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_lagoon"
            android:targetActivity=".LauncherActivity"
            android:theme="@style/Theme.Cue.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityNavy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navy"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_navy"
            android:targetActivity=".LauncherActivity"
            android:theme="@style/Theme.Cue.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityDeepTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_deep_teal"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_deep_teal"
            android:targetActivity=".LauncherActivity"
            android:theme="@style/Theme.Cue.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".processing.SongProcessingService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Persists the in-app language on API 31-32, where the framework has no
             per-app locale store of its own. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
